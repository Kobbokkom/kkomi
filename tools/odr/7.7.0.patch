--- a/src/odr/internal/ooxml/ooxml_file.cpp
+++ b/src/odr/internal/ooxml/ooxml_file.cpp
@@ -98,6 +98,28 @@ OfficeOpenXmlFile::decrypt(const std::string &password) const {
   return decrypted;
 }

+std::string OfficeOpenXmlFile::read_workbook_xml() const {
+  if (file_type() != FileType::office_open_xml_workbook || password_encrypted()) {
+    throw UnsupportedOperation();
+  }
+  const auto workbook = m_files->open(AbsPath("/xl/workbook.xml"));
+  if (!workbook) {
+    throw FileReadError();
+  }
+  constexpr std::size_t max_workbook_xml_bytes = 8 * 1024 * 1024;
+  const std::size_t size = workbook->size();
+  if (size == 0 || size > max_workbook_xml_bytes) {
+    throw FileReadError();
+  }
+  const auto stream = workbook->stream();
+  std::string bytes = util::stream::read(*stream, size);
+  if (bytes.size() != size || stream->peek() != std::char_traits<char>::eof() ||
+      stream->bad()) {
+    throw FileReadError();
+  }
+  return bytes;
+}
+
 bool OfficeOpenXmlFile::is_decodable() const noexcept {
   return m_encryption_state != EncryptionState::encrypted;
 }
